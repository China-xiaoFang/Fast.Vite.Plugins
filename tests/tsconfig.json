{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"moduleDetection": "force",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": false
	},
	"include": ["public-api.test.ts"]
}
